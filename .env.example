# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 개발 중에는 특정 길드에만 슬래시 커맨드를 즉시 등록 (비우면 글로벌 등록, 반영까지 최대 1시간)
DISCORD_DEV_GUILD_ID=

# 저장된 Riot 세션 쿠키를 암호화할 때 쓰는 32바이트 키 (hex 64자)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# 전적/랭크 조회(/rank /matches)의 닉네임#태그 -> PUUID 변환에 사용.
# developer.riotgames.com 개인 키는 24시간마다 재발급 필요 (운영 시 프로덕션 키 신청 고려).
RIOT_API_KEY=

DATABASE_URL="file:./dev.db"
