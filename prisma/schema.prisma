generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  discordId    String        @id
  createdAt    DateTime      @default(now())
  riotAccounts RiotAccount[]
}

model RiotAccount {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [discordId], onDelete: Cascade)
  puuid            String   @unique
  region           String
  shard            String
  riotUsername     String
  encryptedCookie  String
  lastLoginAt      DateTime @default(now())
  wishlistItems    WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id            String      @id @default(cuid())
  riotAccountId String
  riotAccount   RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)
  skinUuid      String
  skinName      String
  addedAt       DateTime    @default(now())

  @@unique([riotAccountId, skinUuid])
  @@index([riotAccountId])
}

// 전적 조회 기능 전용. 개인 상점과 달리 전적/랭크는 공개 정보라
// 유저마다 로그인시킬 필요 없이, 봇이 보유한 계정 하나의 세션으로 임의의
// 플레이어를 조회한다. 통상 단일 row(운영자가 /servicelogin 으로 등록).
model ServiceAccount {
  id              String   @id @default(cuid())
  puuid           String
  region          String
  shard           String
  encryptedCookie String
  lastLoginAt     DateTime @default(now())
}

// 평문 채팅 트리거로 등록하는 커스텀 응답. "세이지 배워 <트리거> <대답>"으로 등록하면
// 이후 "세이지 <트리거>"라고 부를 때 <대답>을 그대로 돌려준다. guildKey는 서버(길드) ID,
// DM에서 배운 경우는 "dm" 고정값을 쓴다(서버 간 트리거가 섞이지 않도록).
model LearnedPhrase {
  id        String   @id @default(cuid())
  guildKey  String
  trigger   String
  response  String
  createdAt DateTime @default(now())

  @@unique([guildKey, trigger])
  @@index([guildKey])
}

// "세이지 오늘의 메뉴" 추천용 후보. 누구나 "세이지 메뉴 추가 <메뉴>"로 계속 늘릴 수 있다.
model MenuItem {
  id       String   @id @default(cuid())
  guildKey String
  name     String
  addedAt  DateTime @default(now())

  @@unique([guildKey, name])
  @@index([guildKey])
}
