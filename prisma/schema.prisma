generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  discordId    String        @id
  createdAt    DateTime      @default(now())
  riotAccounts RiotAccount[]
}

model RiotAccount {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [discordId], onDelete: Cascade)
  puuid            String   @unique
  region           String
  shard            String
  riotUsername     String
  encryptedCookie  String
  lastLoginAt      DateTime @default(now())
  wishlistItems    WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id            String      @id @default(cuid())
  riotAccountId String
  riotAccount   RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)
  skinUuid      String
  skinName      String
  addedAt       DateTime    @default(now())

  @@unique([riotAccountId, skinUuid])
  @@index([riotAccountId])
}

// 노발이(전적 조회) 기능 전용. 개인 상점과 달리 전적/랭크는 공개 정보라
// 유저마다 로그인시킬 필요 없이, 봇이 보유한 계정 하나의 세션으로 임의의
// 플레이어를 조회한다. 통상 단일 row(운영자가 /servicelogin 으로 등록).
model ServiceAccount {
  id              String   @id @default(cuid())
  puuid           String
  region          String
  shard           String
  encryptedCookie String
  lastLoginAt     DateTime @default(now())
}
